-- Day 3: Aggregation (COUNT, SUM, AVG, GROUP BY)
Select * from "Pharma";

-- Query.	Total orders, total revenue, average order value nikalo.

-- Code
Select count(*) As Total_Orders,
Sum(total_amount) As Total_Revenue,
Round(Avg(total_amount),2) As Avg_Value
From "Pharma";

-- Insight : Total Order-> 200, Total Revenue-> 1403869 and Avg Value-> 7019.35.

-- 2.	Region-wise total revenue nikalo.
Select * From "Pharma";
Select region, Sum(total_amount) AS Total_Revenue_Region_Wise
From "Pharma"
Group by region;

-- 3.	Category-wise total quantity sold.
Select Category, Sum(Quantity) As Total_Quantity
From "Pharma"
Group By category;

-- 4.	Har salesperson ke kitne orders aur kitna revenue hai.
Select Salesname, Count(*) AS Total_orders, sum(total_amount) As Total_Sales_amount
From "Pharma"
Group By salesname;

-- 5.	Customer type-wise average order value.
Select Customer_type, Round(Avg(total_amount),2) As Avg_Total_Amount
From "Pharma"
Group By Customer_type;

-- 6.	Top 5 products by revenue.
Select Product, sum(total_amount) AS Total_Revenue
From "Pharma"
Group BY Product 
Order BY Total_Revenue DESC
Limit 5 ;

-- 7.	Wo cities jahan total revenue 50,000 se zyada hai (HAVING).
Select City, Sum(total_amount) As Total_Revenue
From "Pharma"
Group By City
Having SUM(total_amount) > 50000
Order By Total_Revenue DESC;
